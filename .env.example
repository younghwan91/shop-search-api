PORT=3000
HOST=0.0.0.0
# 떠리몰 프론트 코드에 들어있는 공개 clientId. 운영사가 바꾸면 여기만 갱신하면 된다.
SHOPBY_CLIENT_ID=UoI6WXPCVmuu7u/mv6tH2g==
SHOPBY_BASE_URL=https://shop-api.e-ncp.com
THIRTYMALL_API_URL=https://api.thirtymall.com
# 업스트림 응답 캐시 TTL(초)
CACHE_TTL_SECONDS=60
# 클라이언트 IP당 분당 요청 수
RATE_LIMIT_PER_MINUTE=60

# 새 상품 알림 (npm run watch)
# 디스코드 채널 설정 > 연동 > 웹후크 에서 만든 URL
DISCORD_WEBHOOK_URL=
# 쉼표로 여러 개. 검색어마다 검색해서 합친다
WATCH_QUERY=
# brands.json 의 키. 비우면 브랜드 필터 없음
WATCH_BRAND=
# 브랜드 규칙 파일 (brands.example.json 참고)
BRANDS_FILE=brands.json
WATCH_STATE_FILE=data/seen.json
