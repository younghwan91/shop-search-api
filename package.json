{
  "name": "shop-search-api",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "떠리몰·무신사·29CM 상품 검색 API — 캐시·요청 제한·브랜드 필터, 떠리몰 새 상품 디스코드 알림",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "watch": "node dist/watch.js",
    "watch:dry": "node dist/watch.js --dry-run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
